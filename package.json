{
  "name": "food-store-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "A small NestJS food store calculator",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
