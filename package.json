    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
