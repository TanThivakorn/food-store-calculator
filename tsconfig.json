{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "types": ["node", "jest"],
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
